{
  "mcpServers": {
    "telegram": {
      "command": "python3",
      "args": ["/datadir/plugins/comms-pack/mcp/telegram_mcp.py"],
      "env": {
        "TELEGRAM_BOT_TOKEN": "${VAULT:telegram_bot_token.token}",
        "CLODIA_TELEGRAM_STATE": "/datadir/plugins/comms-pack/state/telegram-state.json"
      }
    },
    "mail-transport": {
      "command": "python3",
      "args": ["/datadir/plugins/comms-pack/mcp/mail_transport_mcp.py"]
    }
  }
}
